          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerName\": \"new_user_1\",\n  \"cartSubtotal\": 45.00,\n  \"distanceInKm\": 8.5,\n  \"isRushHour\": false\n}"
            },
