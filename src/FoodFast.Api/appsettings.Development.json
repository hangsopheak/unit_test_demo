{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "OpenTelemetry": {
    "Endpoint": "https://otlp-gateway-prod-ap-southeast-1.grafana.net/otlp",
    "Protocol": "http/protobuf",
    "GrafanaApiKey": "YOUR_KEY_HERE"
  }
}
